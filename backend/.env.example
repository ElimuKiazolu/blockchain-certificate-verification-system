# Backend configuration (Phase 7).
# Copy to `backend/.env` and fill in. `.env` is git-ignored — NEVER commit it.

# ── Pinata (SECRET) ───────────────────────────────────────────────────────
# The JWT from Pinata → API Keys → "New Key" (copy the JWT, not the API
# key/secret pair). This is a SECRET: it lives only here, is only ever read by
# the backend process, and is never sent to the browser or written to logs.
PINATA_JWT=paste-your-pinata-jwt-here

# ── Pinata gateway (NOT secret) ───────────────────────────────────────────
# Base URL used to READ a pinned file back. Public by design — the frontend
# builds "<gateway>/<cid>" links from it. No trailing slash.
PINATA_GATEWAY=https://aquamarine-wooden-flamingo-507.mypinata.cloud/ipfs

# ── Server ────────────────────────────────────────────────────────────────
PORT=4000

# Comma-separated list of browser origins allowed to call this API.
# Vite's dev server is http://localhost:5173.
CORS_ORIGINS=http://localhost:5173

# Largest file accepted for pinning, in megabytes.
MAX_UPLOAD_MB=10
