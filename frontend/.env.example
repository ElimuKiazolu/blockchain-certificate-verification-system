# Frontend configuration (Phase 7). Copy to `frontend/.env` to override.
# Both values have working local-development defaults, so this file is only
# needed when pointing at a different backend or gateway.
#
# NOTE: everything here ships INSIDE the browser bundle. Only ever put public
# values in a VITE_ variable. The Pinata JWT is a secret and belongs in
# backend/.env — never here.

# Where the backend IPFS proxy is reachable.
VITE_API_BASE_URL=http://localhost:4000

# Public IPFS read gateway used to build "View file" links from a stored CID.
# Should match PINATA_GATEWAY in backend/.env. No trailing slash.
VITE_IPFS_GATEWAY=https://aquamarine-wooden-flamingo-507.mypinata.cloud/ipfs
